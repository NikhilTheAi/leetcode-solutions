## This is the most Basic Approach we can go with in starting as a beginner

class Solution:
    def isPowerOfTwo(self, n: int) -> bool:
        isPow = False
        for x in range((n//2) + 1):
            if n == 2**x :
                isPow = True
                break
        return isPow  

## or 
class Solution:
    def isPowerOfTwo(self, n: int) -> bool:
        if n<=0:
            return False
        while n%2==0:
            n = n//2
        return n==1

