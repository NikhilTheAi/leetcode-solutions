# # Brute force approach is : first sort both the string and compare them => if same anagram another no anagram but
# time complexity : O(nlogn) + O(nlogn) = O(nlogn)

## Can we optimize it ? yes we can count each word's frequency in s like a: 3 and all then substract the t char 
## char_freq from it . if it is 0 => it is anagram another not anagram.

#case1.  if len of both string same => anagram . if not => no anagram
#Case 2 : if char in t is not in char_freq then return false or print no anagram

class Solution:
    def isAnagram(self, s: str, t: str) -> bool:

        if len(s) != len(t):
            return False

        char_freq = {}

        # Count frequency of s
        for ch in s:
            char_freq[ch] = char_freq.get(ch, 0) + 1

        # Subtract using t
        for ch in t:
            if ch not in char_freq:
                return False

            if char_freq[ch] == 0:
                return False

            char_freq[ch] -= 1

        return True
