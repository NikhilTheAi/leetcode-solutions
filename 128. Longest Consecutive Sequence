# Brute Force Sol Then little Better version and then using hashmap we got optimal solution.
## Set is used so that unique nums we get . we care only for cons nums not duplicates.

class Solution:
    def longestConsecutive(self, nums: list[int]) -> int:
        my_set = set(nums)
        longest = 0

        for num in my_set:
            if num - 1 not in my_set:
                x = num
                count = 1

                while x + 1 in my_set:
                    count += 1
                    x += 1

                longest = max(longest, count)

        return longest
